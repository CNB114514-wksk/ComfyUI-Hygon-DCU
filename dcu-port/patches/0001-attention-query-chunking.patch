+import os
 
 import torch
 import torch.nn.functional as F
@@ -865,14 +866,30 @@ def attention_flash(q, k, v, heads, mask=None, attn_precision=None, skip_reshape
     try:
         if mask is not None:
             raise RuntimeError("Mask must not be set for Flash attention")
-        out = flash_attn_wrapper(
-            q.transpose(1, 2),
-            k.transpose(1, 2),
-            v.transpose(1, 2),
-            dropout_p=0.0,
-            causal=False,
